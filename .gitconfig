[core]
	editor = vi
	symlinks = false

[alias]
	branch-prune = !git for-each-ref --format '%(if:equals=[gone])%(upstream:track)%(then)%(refname:short)%(end)' | xargs -r git branch -d
	worktree-prune = !git for-each-ref --format '%(if:equals=[gone])%(upstream:track)%(then)%(worktreepath)%(end)' | xargs -r git worktree remove
	l = log --oneline --graph
	push-force = push --force-with-lease --force-if-includes

[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential

[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential
