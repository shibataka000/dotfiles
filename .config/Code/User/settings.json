{
    "[json][jsonc][jsonl]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },
    "[markdown][instructions][skill]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.tabSize": 2,
        "editor.unicodeHighlight.invisibleCharacters": false,
        "files.trimTrailingWhitespace": false,
        "workbench.editor.languageDetection": false
    },
    "[terraform][terraform-deploy][terraform-mock][terraform-search][terraform-stack][terraform-test][terraform-vars][terraform-version]": {
        "editor.defaultFormatter": "hashicorp.terraform"
    },
    "breadcrumbs.enabled": false,
    "diffEditor.ignoreTrimWhitespace": false,
    "editor.colorDecorators": false,
    "editor.copyWithSyntaxHighlighting": false,
    "editor.formatOnSave": true,
    "editor.minimap.enabled": false,
    "editor.occurrencesHighlight": "off",
    "editor.renderWhitespace": "all",
    "editor.stickyScroll.enabled": false,
    "explorer.confirmDragAndDrop": false,
    "explorer.confirmPasteNative": false,
    "extensions.autoUpdateDelay": 168,
    "extensions.ignoreRecommendations": true,
    "files.associations": {
        "*.hcl": "terraform"
    },
    "files.autoGuessEncoding": true,
    "files.defaultLanguage": "markdown",
    "files.exclude": {
        "**/.git": true,
        "**/.terraform": true
    },
    "files.insertFinalNewline": true,
    "files.trimFinalNewlines": true,
    "files.trimTrailingWhitespace": true,
    "files.watcherExclude": {
        "**/.git/**": true,
        "**/.terraform/**": true,
        "**/.venv/**": true,
        "**/node_modules/**": true
    },
    "git.autofetch": false,
    "git.confirmSync": false,
    "git.enableSmartCommit": true,
    "git.ignoreMissingGitWarning": true,
    "git.openRepositoryInParentFolders": "never",
    "go.toolsManagement.autoUpdate": true,
    "go.useLanguageServer": true,
    "scm.repositories.selectionMode": "single",
    "search.exclude": {
        "**/.git": true,
        "**/.terraform": true,
        "**/.venv": true,
        "**/node_modules": true
    },
    "security.workspace.trust.enabled": false,
    "workbench.editor.decorations.badges": false,
    "workbench.editor.decorations.colors": false,
    "workbench.startupEditor": "newUntitledFile"
}
